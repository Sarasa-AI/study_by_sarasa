# NODE_ENV is set by the host (development | production | test) — do not put it here.

# --- Required core ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medical_mvp?schema=public"
NEXTAUTH_SECRET="replace-with-a-strong-secret"
NEXTAUTH_URL="http://localhost:3000"
# Used for SSR fetches and OpenRouter HTTP-Referer; set to the public app URL in production.
APP_BASE_URL="http://localhost:3000"
# Required at module load for any code path that imports the AI gateway.
OPENROUTER_API_KEY=

# --- AI ---
OPENROUTER_DEFAULT_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# Required for RAG embeddings (text-embedding-3-small) and clinical KB ingestion.
OPENAI_API_KEY=

# --- Auth extras ---
# Comma-separated instructor access codes (empty = no instructor codes).
INSTRUCTOR_CODES="INST001"

# --- Email / cron (required when using mail or weekly digest) ---
RESEND_API_KEY="replace-with-your-resend-api-key"
MAIL_FROM="PedsMorningAI <digest@example.com>"
MAIL_DRY_RUN="false"
SEND_EMAIL_TIMEOUT_MS="10000"
CRON_SECRET="replace-with-a-strong-cron-secret"

# --- Observability ---
LOG_LEVEL="debug"
